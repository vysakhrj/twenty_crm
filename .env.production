# MyCRM Production Environment Configuration
# Copy this file to .env and customize for your deployment

NODE_ENV=production

# =============================================================================
# REQUIRED: Database and Redis
# =============================================================================
PG_DATABASE_URL=postgres://mycrm:your_secure_password@db:5432/mycrm
REDIS_URL=redis://redis:6379

# =============================================================================
# REQUIRED: Security
# =============================================================================
# Generate a secure random string (e.g., openssl rand -base64 32)
APP_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# =============================================================================
# REQUIRED: URLs
# =============================================================================
# Your domain - change these to your actual domain
SERVER_URL=https://api.mycrm.example.com
FRONTEND_URL=https://app.mycrm.example.com

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Enable password authentication (recommended for white-label)
AUTH_PASSWORD_ENABLED=true

# Disable Google/Microsoft OAuth (enable if needed)
MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false

# Disable multi-workspace for single-tenant deployment
IS_MULTIWORKSPACE_ENABLED=false

# Prefill sign-in for demo purposes (set to false in production)
SIGN_IN_PREFILLED=false

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local storage (default) or S3
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage

# Uncomment for S3 storage:
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_NAME=your-bucket-name
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Required for password reset, invitations, etc.
EMAIL_FROM_ADDRESS=noreply@mycrm.example.com
EMAIL_FROM_NAME='MyCRM'
EMAIL_SYSTEM_ADDRESS=system@mycrm.example.com
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_smtp_user
EMAIL_SMTP_PASSWORD=your_smtp_password

# =============================================================================
# OPTIONAL: Features
# =============================================================================
# Serverless functions
SERVERLESS_TYPE=local
SERVERLESS_LOGS_ENABLED=true

# Disable features not needed for lead management
IS_BILLING_ENABLED=false
IS_IMAP_SMTP_CALDAV_ENABLED=false

# =============================================================================
# OPTIONAL: Monitoring & Logging
# =============================================================================
LOGGER_DRIVER=CONSOLE
LOG_LEVELS=error,warn,log

# Uncomment for Sentry error tracking:
# EXCEPTION_HANDLER_DRIVER=sentry
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=production
